    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/web-push": "^3.6.4",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
