# Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the values below.

# ============================================
# SECRETS (never commit real values)
# ============================================

# MongoDB Connection
MONGODB_URI=mongodb://admin:admin123@localhost:27017/become?authSource=admin

# JWT Secret (generate a random 32+ char string for production)
JWT_SECRET=your-secret-key-change-this-in-production

# Email configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@yourdomain.com

# Redis (optional, currently unused)
# REDIS_URL=redis://localhost:6379

# ============================================
# PUBLIC VARIABLES (safe to share)
# ============================================

NEXT_PUBLIC_APP_NAME=BECOME
NEXT_PUBLIC_APP_TAGLINE=No-nonsense, results-oriented coaching. Transformations only.
NEXT_PUBLIC_LOGO=/logo.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
