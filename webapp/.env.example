# Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the values below.

# ============================================
# SECRETS (never commit real values)
# ============================================

# Local MongoDB connection. Production uses auth.mongoUri from the shared
# BECOME_RUNTIME_CONFIG secret instead of reading this variable.
MONGODB_URI=mongodb://localhost:27017/become

# Local JWT secret (use a newly generated random value; never commit it).
JWT_SECRET=generate-a-random-local-secret

# Optional local redsecrets bootstrap. When omitted, local env values above are
# used by the runtime boundary directly.
# REDSECRETS_MONGODB_URI=mongodb://localhost:27017/become
# SECRETS_ENCRYPTION_KEY=generate-a-random-32-byte-key

# Email configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@yourdomain.com

# Redis (optional, currently unused)
# REDIS_URL=redis://localhost:6379

# Billing (Stripe). ALL OPTIONAL. With none of it set, /api/billing/checkout and
# /api/billing/portal answer 503 billing_not_configured and the upgrade sheet
# shows its coming-soon note — that is the app's normal state today.
#
# These are LOCAL-DEV ONLY. runtimeConfig ignores process.env entirely when
# NODE_ENV === 'production' (which `next start` sets), so setting them as RedRun
# env vars does nothing: production reads billing.* from BECOME_RUNTIME_CONFIG
# in redsecrets.
#
# STRIPE_SECRET_KEY=            # sk_test_… / sk_live_… — the key decides the mode
# STRIPE_WEBHOOK_SECRET=        # whsec_…, one per registered endpoint
# STRIPE_PRICE_PLUS_MONTHLY=    # price_…
# STRIPE_PRICE_PLUS_ANNUAL=     # price_…
# STRIPE_MODE=test              # only breaks a tie when no key is set

# ============================================
# PUBLIC VARIABLES (safe to share)
# ============================================

NEXT_PUBLIC_APP_NAME=BECOME
NEXT_PUBLIC_APP_TAGLINE=No-nonsense, results-oriented coaching. Transformations only.
NEXT_PUBLIC_LOGO=/logo.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
